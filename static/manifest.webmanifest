{
  "id": "/",
  "name": "Pile of Memories",
  "short_name": "Memories",
  "description": "A private spatial board for capturing and connecting memories.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#edefeb",
  "theme_color": "#edefeb",
  "share_target": {
    "action": "/?action=new-memory",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "share_title", "text": "share_text", "url": "share_url" }
  },
  "icons": [
    { "src": "/app-icon.png", "sizes": "1254x1254", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "New memory",
      "short_name": "New memory",
      "description": "Capture a new memory",
      "url": "/?action=new-memory",
      "icons": [{ "src": "/shortcut-new-memory.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
