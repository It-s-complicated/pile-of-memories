# Local/direct Dockerfile config. Coolify Compose mappings live in compose.coolify.yaml.
# Do not paste literal $SERVICE_* references here; Node does not expand them.
DATABASE_CONNECTION_STRING=
# Required session-mode URL for database change notifications.
DATABASE_LISTEN_CONNECTION_STRING=
# Set to false only when the database does not serve TLS, such as a database
# reachable on a private container network.
DATABASE_SSL=true
# OpenCode Console (Zen) service-account key; pay-as-you-go credits are required.
OPENCODE_API_KEY=
# At least 32 random characters. Used only for private analytics HMAC fingerprints.
ANALYTICS_FINGERPRINT_KEY=
# Stable numeric GitHub user ID allowed to access the board.
APPROVED_GITHUB_PROVIDER_ID=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# For adapter-node behind Coolify's trusted proxy, also set at runtime:
# PROTOCOL_HEADER=x-forwarded-proto
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TYPESAFE_API_KEY=
