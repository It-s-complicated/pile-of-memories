# DID of the single approved account, e.g. did:plc:…
APPROVED_ATPROTO_DID=
# openssl rand -base64 32. Encrypts and authenticates OAuth cookies.
AUTH_SECRET=
# Canonical public origin, without a trailing slash. HTTPS required in production.
# Netlify previews/branch deploys automatically use their DEPLOY_PRIME_URL instead.
AUTH_ORIGIN=http://127.0.0.1:5173
# Enables DeepSeek V4 Flash title and tag suggestions through OpenCode Go.
OPENCODE_GO_API_KEY=
