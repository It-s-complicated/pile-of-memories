# Mock mode (`vp run dev:mock`). MSW answers GitHub, OpenCode and TypeSafe from src/mocks, so
# nothing in this file is a real credential and the file is safe to commit.
# The database is the disposable local one started by `vp run db:mock`. Its name must end in
# _mock: mock mode refuses to start against anything else.
DATABASE_CONNECTION_STRING=postgresql://postgres:mock@127.0.0.1:54329/pile_of_memories_mock
DATABASE_LISTEN_CONNECTION_STRING=postgresql://postgres:mock@127.0.0.1:54329/pile_of_memories_mock
DATABASE_SSL=false
# The mock GitHub always signs in as this account.
APPROVED_GITHUB_PROVIDER_ID=1
BETTER_AUTH_SECRET=mock-better-auth-secret-not-a-real-secret
BETTER_AUTH_URL=http://localhost:5173
GITHUB_CLIENT_ID=mock-github-client
GITHUB_CLIENT_SECRET=mock-github-secret
OPENCODE_API_KEY=mock-opencode-key
TYPESAFE_API_KEY=mock-typesafe-key
ANALYTICS_FINGERPRINT_KEY=mock-analytics-fingerprint-key-not-secret
