    "@tanstack/ai-openai": "^0.26.0",
    "@tanstack/browser-db-sqlite-persistence": "^0.2.28",
    "@tanstack/svelte-db": "^0.5.3",
    "@xyflow/svelte": "^1.7.0",
    "advocaat": "^0.0.6",
    "better-auth": "^1.7.7",
    "marked": "^18.0.14",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "svelte": "^5.57.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-netlify": "7.0.0",
