{
  "name": "pile-of-memories",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "start": "node build",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:tunnel": "node --env-file-if-exists=.env scripts/database-tunnel.mjs",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json --tsgo-experimental-api",
    "prepare": "svelte-kit sync"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/cutive-mono": "^5.3.0",
    "@humanspeak/svelte-markdown": "~2.2.0",
    "@tanstack/ai": "^1.0.1",
    "@tanstack/ai-openai": "^1.0.1",
    "@tanstack/ai-typesafe": "^1.0.0",
    "@tanstack/browser-db-sqlite-persistence": "^1.0.0-rc.1",
    "@tanstack/svelte-db": "^1.0.0-rc.1",
    "@xyflow/svelte": "^1.7.0",
    "better-auth": "^1.7.14",
    "marked": "^18.1.2",
    "pg": "^8.23.1",
    "postgres": "^4.0.0",
    "svelte": "^5.57.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.1",
    "@sveltejs/kit": "3.1.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@typescript/native-preview": "npm:typescript@7.0.2",
    "agent-browser": "^0.41.0",
    "svelte-check": "^4.7.7",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "file:../../lightningcss@1.32.0/node_modules/lightningcss": true,
    "file:../../browser-fs-access@0.29.1/node_modules/browser-fs-access": true
  },
  "intent": {
    "skills": [
      "@tanstack/ai",
      "@tanstack/db",
      "@tanstack/svelte-db"
    ]
  }
}
